# Optional — leave blank to use Web Speech API only (always free)
# Azure Speech SDK free tier (F0): 500,000 chars/month
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ElevenLabs free tier: 10,000 chars/month
ELEVENLABS_API_KEY=

# Google Gemini API Key (Free tier from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.5-flash-lite

# xAI Grok API Key (https://console.x.ai/ - format: xai-...)
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Express proxy port
PORT=3001

# Supabase (Optional for cloud sync and persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Security & CORS Configuration
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Admin Panel Secret — set a strong password for /admin access
ADMIN_SECRET=YOUR_SECURE_ADMIN_PASSWORD_HERE
