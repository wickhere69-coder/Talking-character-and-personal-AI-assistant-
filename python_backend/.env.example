# Python Backend Configuration
PORT=8000
DEBUG=false
LOG_LEVEL=info

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Provider (auto | gemini | grok | local)
MODEL_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Text brain for the LangGraph path + deep_think tool (fails over down the chain on 503/timeout)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_DEEP_THINKING_LEVEL=high
LLM_FIRST_TOKEN_TIMEOUT_S=6
LLM_MODEL_COOLDOWN_S=90

# Gemini Live real-time voice brain
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_THINKING_LEVEL=low
# Prebuilt voices: Aoede (breezy), Leda (youthful), Kore (firm), Sulafat (warm), Achernar (soft), Puck (upbeat), Charon, Fenrir ...
GEMINI_LIVE_VOICE=Aoede
# native_gemini_live = Gemini's expressive voice (recommended) | custom_voice_pack = ElevenLabs reads the transcript
VOICE_MODE=native_gemini_live
# Turn-taking (server VAD)
LIVE_VAD_START_SENSITIVITY=high
LIVE_VAD_END_SENSITIVITY=high
LIVE_VAD_PREFIX_PADDING_MS=100
LIVE_VAD_SILENCE_MS=600

# xAI Grok (also accepts XAI_API_KEY) — last-resort text fallback
GROK_API_KEY=your_grok_api_key_here
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-3-mini

# Database
DB_PATH=data/sessions.db

# Legacy data migration (TypeScript data files)
LEGACY_SESSIONS_PATH=../data/sessions.json
LEGACY_MEMORY_PATH=../data/memory.json

# Session memory
MAX_HISTORY_TURNS=8
MAX_LONG_TERM_MEMORIES=50
SUMMARIZE_EVERY_N_MESSAGES=4
