# Python Backend Configuration
PORT=8000
DEBUG=false
LOG_LEVEL=info

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Provider (auto | gemini | grok | local)
MODEL_PROVIDER=auto

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.0-flash-lite

# xAI Grok (also accepts XAI_API_KEY)
GROK_API_KEY=your_grok_api_key_here
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-3-mini

# Database
DB_PATH=data/sessions.db

# Legacy data migration (TypeScript data files)
LEGACY_SESSIONS_PATH=../data/sessions.json
LEGACY_MEMORY_PATH=../data/memory.json

# Session memory
MAX_HISTORY_TURNS=8
MAX_LONG_TERM_MEMORIES=50
SUMMARIZE_EVERY_N_MESSAGES=4
